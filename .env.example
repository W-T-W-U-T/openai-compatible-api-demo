# 复制本文件为 .env 后填入你自己的值（.env 已在 .gitignore 中，不会被提交）
# cp .env.example .env

# 1) API Key —— 必填。DeepSeek 平台在 https://platform.deepseek.com/api_keys 申请
OPENAI_API_KEY=sk-在这里替换成你的真实Key

# 2) 接口地址 —— 换成不同平台只需改这一行（末尾不要多余的 /）
#   DeepSeek   https://api.deepseek.com
#   OpenAI     https://api.openai.com/v1
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1
#   月之暗面   https://api.moonshot.cn/v1
#   本地 Ollama http://127.0.0.1:11434/v1
OPENAI_BASE_URL=https://api.deepseek.com

# 3) 模型名（DeepSeek 官方当前模型）
#   deepseek-flash  = DeepSeek-V4.1-Flash：便宜、快，默认选它
#   deepseek-v4-pro = 更强的旗舰模型，价格约 4~5 倍
#   其他平台示例：gpt-4o-mini / qwen-plus / moonshot-v1-8k / llama3.1
OPENAI_MODEL=deepseek-flash
